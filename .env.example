# 崇岳鉴渊 — API 密钥配置
# 复制此文件为 .env 并填入真实密钥（.env 已加入 .gitignore）
# ⚠️ Render 部署需在 Dashboard → Environment 中手动添加这些变量

# 豆包 AI（火山引擎 Ark）- 用于 AI 智能助手（流式对话 + RAG 知识库检索）
# 获取方式：https://console.volcengine.com/ark → 创建推理接入点 → 获取 API Key
DOUBAO_API_KEY=your_key_here
DOUBAO_ENDPOINT_ID=your_endpoint_id_here
# 可选：改用其他 OpenAI 兼容接口（设置后优先于上面的豆包配置），例如 DeepSeek
# CYJY_AI_BASE_URL=https://api.deepseek.com
# CYJY_AI_API_KEY=your_key_here
# CYJY_AI_MODEL=deepseek-chat
# 大模型每天的调用上限（防止被刷爆账单，0 表示不限）：全站 / 每个访客 IP
# CYJY_AI_DAILY_LIMIT=2000
# CYJY_AI_DAILY_PER_IP=200

# 管理员初始密码（至少 8 位；本地不设置时为 admin123，线上必须设置，且线上禁止用 admin123 登录）
CYJY_ADMIN_PASSWORD=your_admin_password_here

# 密码恢复密钥（用于 /api/v1/auth/forgot-password 紧急重置任意账号的密码，请用足够长的随机字符串）
CYJY_RECOVERY_KEY=your_recovery_key_here

# 数学竞赛真题库在线阅读（可选，二选一）
# 推荐：Google API 密钥（启用 Google Drive API），直接读取公开的 Google Drive 文件夹
# CYJY_GDRIVE_API_KEY=your_google_api_key_here
# 或：Cloudflare R2 公网地址（先用 upload_math_to_r2.py 上传）
# CYJY_MATH_FILES_URL=https://pub-xxxx.r2.dev

# 管理后台内容管理（线上必填，否则页面编辑、文件库、学习资源为只读）
# Fine-grained 令牌：只授权本仓库，Repository permissions → Contents 选 Read and write
# 设置后，后台修改会提交到仓库（带 [skip render]，不触发重新部署），上传的文件保存到 Release「site-files」
# CYJY_GITHUB_TOKEN=github_pat_xxx
# CYJY_GITHUB_REPO=hanjiongmin-stack/chongyue-jianyuan
# CYJY_GITHUB_BRANCH=main

# 雅思单词记录本（公开仓库只读同步；默认从 main 的 JSON 文件获取，每分钟检查一次）
# CYJY_VOCAB_BRANCH=main
# CYJY_VOCAB_PATH=content/ielts-words.json

# GitHub Token（可选）- 提升科研孵化页 GitHub 搜索的速率限制（代理只转发公开仓库和 issue 的搜索）
# GITHUB_TOKEN=your_token_here

# 外部数据库（可选）- 不设置时使用本地 SQLite（data/chongyue.db）
# 线上（Render 免费实例）建议设置，否则每次重启都会清空账号、收藏和学习进度；推荐 Neon 的免费 Postgres
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# JWT 密钥（可选）- 未设置时自动生成：配置了 DATABASE_URL 时保存在数据库里，否则保存到 .secret_key 文件
# CYJY_SECRET_KEY=your_secret_here
